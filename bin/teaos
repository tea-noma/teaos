#!/usr/bin/env node
const path = require('path');
const cwd = process.cwd();

function findProjectRoot(startDir){
  let current = path.resolve(startDir);
  while(true){
    if(fs.existsSync(path.join(current, 'package.json'))){
      return current;
    }
    const parent = path.dirname(current);
    if(parent === current){
      return startDir;
    }
    current = parent;
  }
}

const fs = require('fs');
const libTeaos = require("..");
const projectRoot = findProjectRoot(cwd);
let teaos = null;

try {
  teaos = require(path.join('../' + libTeaos.makeRequirePath(projectRoot), 'node_modules/teaos'));
}catch(err){
  console.error(err);
  teaos = libTeaos;
}

const pack = require("../package.json");

const teaosTool = require('../lib/objects/teaos-tool');

const reports = [];

function log_trace(type, desc, traces){
  reports.push({type, desc, traces});
}

function log_report(){
  for(let i = 0; i < reports.length; i++){
    const report = reports[i];
    const trace = traces_getPackage(report.traces);
    if(trace){
      console.log(report.type, report.desc, trace.rel, trace.name, trace.line, trace.offset);
    }else{
      console.log(report.type, report.desc);
    }
  }
}

function loadTeaosTool(name){
  const toolFile = path.join(__dirname, '../lib/extensions/teaos-tool/' + name + '.js');
  try {
    fs.statSync(toolFile);
    require(toolFile);
    return true;
  }catch(err){
    return false;
  }
}

function loadExternalTeaosTool(name){
  if(!name || (name.indexOf('/') === -1)){
    return false;
  }

  const index = name.indexOf('/');
  const packageName = name.slice(0, index);
  const toolName = name.slice(index + 1);
  const localPackageName = packageName[0] === '@' ? packageName.slice(1) : packageName;

  if(!localPackageName || !toolName){
    return false;
  }

  const candidates = [
    path.join(projectRoot, 'lib', localPackageName, 'lib/extensions/teaos-tool', toolName + '.js'),
    path.join(projectRoot, 'node_modules', localPackageName, 'lib/extensions/teaos-tool', toolName + '.js')
  ];

  for(let i = 0; i < candidates.length; i++){
    try {
      fs.statSync(candidates[i]);
      require(candidates[i]);
      return true;
    }catch(err){
    }
  }

  return false;
}

function normalizeExternalTeaosToolName(name){
  if(!name || (name.indexOf('/') === -1)){
    return name;
  }
  const index = name.indexOf('/');
  const packageName = name.slice(0, index);
  if(packageName[0] !== '@'){
    return name;
  }
  return packageName.slice(1) + name.slice(index);
}

teaos.set('libpath', libTeaos.makeRequirePath(projectRoot) + '/lib/');

teaos.on('require', (name) => {
  const traces = getStackTrace();
  log_trace('require', name, traces);
});

teaos.on('declare', (desc) => {
  const traces = getStackTrace();
  log_trace('declare', desc, traces);
});

libTeaos.on('declare', (desc) => {
  if(desc.type == 'teaos-tool'){
    teaosTool.declare(desc);
  }
});

function getPackages(){
  const results = [];
  try {
    const files = fs.readdirSync(path.join(projectRoot, 'lib'));
    for(let i = 0; i < files.length; i++){
      try {
        fs.statSync(path.join(projectRoot, 'lib', files[i], 'index.js'));
        results.push(files[i]);
      }catch(err){
      }
    }
  }catch(err){
  }
  return results;
}

function getStackTrace(){
  const results = [];
  try { throw new Error(); }
  catch (e) {
    let regex = /(\w+)@|at ([^ ]+) \(([^)]+):([0-9]+):([0-9]+)\)/g;
    let stack = e.stack;
    let m;
    while(m = regex.exec(stack)){
      let callerName = (m != null) ? m[1] || m[2] : 'NONE';
      let trace = {name: callerName, path: m[3], line: m[4], offset: m[5]};
      if(trace.path.substr(0, projectRoot.length) == projectRoot){
        trace.type = 'in-project';
        trace.rel = trace.path.substr(projectRoot.length + 1).replace(/\\/g, '/');
        if(trace.rel.substr(0, 4) == 'lib/'){

        }
      }
      results.push(trace);
    }
  }
  return results;
}

function traces_getPackage(traces){
  for(let i = 0; i < traces.length; i++){
    if(traces[i].type == 'in-project'){
      return traces[i];
    }
  }
  return null;
}

teaosTool.setRuntime({
  teaos,
  getPackages,
  logReport: log_report
});

const cmd = process.argv[2] == 'desc' ? 'require' : process.argv[2];
if(cmd){
  if(!loadTeaosTool(cmd)){
    loadExternalTeaosTool(cmd);
  }
}
let executed = teaosTool.exec(cmd, process.argv);

if((!executed) && cmd){
  const normalizedCmd = normalizeExternalTeaosToolName(cmd);
  if(normalizedCmd !== cmd){
    executed = teaosTool.exec(normalizedCmd, process.argv);
  }
}

if((!executed) && cmd && (cmd.indexOf('/') !== -1)){
  const subCmd = cmd.slice(cmd.indexOf('/') + 1);
  executed = teaosTool.exec(subCmd, process.argv);
}

if(!executed){
  console.log("teaos package: ", pack.version);
}
