#!/usr/bin/env node
const path = require('path');
const cwd = process.cwd();

const libTeaos = require("..");
let teaos = null;

try {
  teaos = require(path.join('../' + libTeaos.makeRequirePath(cwd), 'node_modules/teaos'));
}catch(err){
  console.error(err);
  teaos = libTeaos;
}

const pack = require("../package.json");
const fs = require('fs');

const reports = [];

function log_trace(type, desc, traces){
  reports.push({type, desc, traces});
}

function log_report(){
  for(let i = 0; i < reports.length; i++){
    const report = reports[i];
    const trace = traces_getPackage(report.traces);
    if(trace){
      console.log(report.type, report.desc, trace.rel, trace.name, trace.line, trace.offset);
    }else{
      console.log(report.type, report.desc);
    }
  }
}

// teaos.set("libpath", libTeaos.makeRequirePath(cwd) + '/lib/');

teaos.on('require', (name) => {
  const traces = getStackTrace();
  log_trace('require', name, traces);
});

teaos.on('declare', (desc) => {
  const traces = getStackTrace();
  log_trace('declare', desc, traces);
});

function getPackages(){
  const results = [];
  try {
    const files = fs.readdirSync("./lib");
    for(let i = 0; i < files.length; i++){
      try {
        fs.statSync("./lib/" + files[i] + "/index.js");
        results.push(files[i]);
      }catch(err){
      }
    }
  }catch(err){
  }
  return results;
}

function getStackTrace(){
  const results = [];
  try { throw new Error(); }
  catch (e) {
    let regex = /(\w+)@|at ([^ ]+) \(([^)]+):([0-9]+):([0-9]+)\)/g;
    let stack = e.stack;
    let m;
    while(m = regex.exec(stack)){
      let callerName = (m != null) ? m[1] || m[2] : 'NONE';
      let trace = {name: callerName, path: m[3], line: m[4], offset: m[5]};
      if(trace.path.substr(0, cwd.length) == cwd){
        trace.type = 'in-project';
        trace.rel = trace.path.substr(cwd.length + 1).replace(/\\/g, '/');
        if(trace.rel.substr(0, 4) == 'lib/'){

        }
      }
      results.push(trace);
    }
  }
  return results;
}

function traces_getPackage(traces){
  for(let i = 0; i < traces.length; i++){
    if(traces[i].type == 'in-project'){
      return traces[i];
    }
  }
  return null;
}

switch(process.argv[2]){
  case 'desc':
  case 'require':{
    teaos.require('@' + process.argv[3]);
    log_report(process.argv[3]);
    break;}
  case 'use.all':{
    const results = getPackages();
    for(let i = 0; i < results.length; i++){
      teaos.use('@' + results[i], { resources: '*' });
    }
    log_report(null);
    break;}
  case 'use':{
    teaos.use('@' + process.argv[3], { resources: '*' });
    log_report(process.argv[3]);
    break;}
  case 'require.all':{
    const results = getPackages();
    for(let i = 0; i < results.length; i++){
      teaos.require('@' + results[i]);
    }
    log_report(null);
    break;}
  case 'ls':{
    const results = getPackages();
    console.log(results);
    break;}
  default:
    console.log("teaos package: ", pack.version);
    break;
}
